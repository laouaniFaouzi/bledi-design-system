{
  "name": "@bledi/design-system",
  "version": "0.1.0",
  "description": "Bledi — système de composants React/TypeScript officiel (tokens, primitives, composants métier).",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./src/styles.css",
    "./assets/*": "./assets/*"
  },
  "files": [
    "dist",
    "src/styles.css",
    "src/tokens",
    "assets"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c .oxlintrc.json src",
    "examples": "vite --port 5173",
    "examples:build": "vite build",
    "prepare": "tsup"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "oxlint": "^0.15.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/laouaniFaouzi/bledi-design-system.git"
  }
}
